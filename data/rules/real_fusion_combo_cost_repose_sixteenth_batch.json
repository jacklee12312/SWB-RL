          "target": "enemy_leader",
          "amount": {"type": "source_fusion_distinct_name_count"}
        }
      ]
    },
    {
      "card_id": 10514110,
      "trigger": "fanfare",
      "coverage": "exact",
      "implemented_text": "【<color=Keyword>入场曲</color>】本随从+X/+X。X为自己的【<color=Keyword>连击</color>】。\n<hr><ev>【<color=Keyword>进化时</color>】舍弃自己的所有手牌。将对手的牌组中的随机5张卡牌的复制卡牌各1张以非公开形式加入自己的手牌。</ev>",
      "operations": [
        {
          "kind": "buff_unit",
          "target": "self",
          "amount": {"type": "controller_combo"},
          "secondary_amount": {"type": "controller_combo"}
        }
      ]
    },
