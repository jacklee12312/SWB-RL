    },
    {
      "card_id": 10342110,
      "trigger": "turn_end",
      "coverage": "exact",
      "implemented_text": "【<color=Keyword>突进</color>】\n【<color=Keyword>守护</color>】\n自己的回合结束时，本随从回复至上限。回复自己的主战者X点生命值。X为因本能力回复的数值。",
      "operations": [
