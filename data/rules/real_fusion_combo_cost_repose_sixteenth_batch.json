    {
      "card_id": 10332210,
      "trigger": "play",
      "countdown": 5,
      "coverage": "exact",
      "implemented_text": "【<color=Keyword>吟唱</color>_5】\n自己使用费用发生变化的随从时，抽取1张卡牌。本护符的倒计数-1。\n<hr>【<color=Keyword>启动</color>】选择自己的手牌中的1张随从，使其费用+1，使其+1/+1。",
      "operations": []
    },
