  "rules": [
    {
      "card_id": 10324110,
      "trigger": "fanfare",
      "coverage": "exact",
      "implemented_text": "【<color=Keyword>融合</color>】财宝·卡牌\n<hr>【<color=Keyword>入场曲</color>】对对手的战场上的所有随从和对手的主战者造成X点伤害。X为与本卡牌【<color=Keyword>融合</color>】的种类。\n<hr><sev>【<color=Keyword>超进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</sev>",
      "operations": [
        {
          "kind": "damage_unit",
          "target": "all_enemy_units",
